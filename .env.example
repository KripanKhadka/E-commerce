DJANGO_SECRET_KEY=change-me-in-production
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=127.0.0.1,localhost

# The base URL customers return to after payment.
SITE_URL=http://127.0.0.1:8000

# eSewa ePay v2
# Test: rc-epay.esewa.com.np
# Production: epay.esewa.com.np
ESEWA_ENV=test
ESEWA_PRODUCT_CODE=EPAYTEST
ESEWA_SECRET_KEY=8gBm/:&EnhH.1/q

# Optional branding
SHOP_NAME=Hamro Sports

# Optional: used by `python manage.py fetch_real_images` to download real
# product photos. Free key from https://www.pexels.com/api/
PEXELS_API_KEY=

# --- Postgres (required on Vercel; SQLite is used locally if left unset) ---
# Set automatically if you attach Vercel Postgres/Neon in the dashboard.
# DATABASE_URL=postgres://user:password@host/dbname

# --- External media storage (required on Vercel) ---
# Product/hero-slide images uploaded via /admin/ need external storage since
# Vercel's filesystem doesn't persist. Works with AWS S3, Cloudflare R2,
# Backblaze B2, or DigitalOcean Spaces. Leave blank for local dev or Render
# (where local disk works fine).
# AWS_STORAGE_BUCKET_NAME=your-bucket-name
# AWS_ACCESS_KEY_ID=your-access-key
# AWS_SECRET_ACCESS_KEY=your-secret-key
# AWS_S3_ENDPOINT_URL=https://<account-id>.r2.cloudflarestorage.com  # only needed for R2/Spaces, omit for real AWS S3
# AWS_S3_REGION_NAME=auto
# AWS_S3_CUSTOM_DOMAIN=media.yourdomain.com  # optional CDN/custom domain
